# Copy to .env for local development. Every value here is a FAKE development value.
# Production and staging refuse to boot with weak or missing values (see apps/api/src/config/env.ts).
APP_ENV=development
APP_ROLE=all
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
RELEASE=dev

# PostgreSQL. Local: scripts/dev-services.sh start (port 55432) or docker compose up.
DATABASE_URL=postgres://qs_admin:qs_admin_dev_pw@127.0.0.1:55432/qs_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000

# Redis 7+. Use an ACL user, never the default user. Production requires rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:56379
REDIS_USERNAME=ops
REDIS_PASSWORD=devpass-ops

CORS_ALLOWED_ORIGINS=http://localhost:3001
TRUST_PROXY=false

# fake is allowed only in development and test. Production refuses to boot with it (spec section 150).
PAYMENT_PROVIDER=fake

# Optional observability. Empty means off.
SENTRY_DSN=
OTEL_ENABLED=false
