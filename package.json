{
  "name": "queue-saas",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time queue management SaaS (modular monolith). Phase 1: foundation.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm --filter @qs/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @qs/shared build && pnpm -r test",
    "test:integration": "pnpm --filter @qs/shared build && pnpm --filter @qs/api test:integration",
    "db:migrate": "pnpm --filter @qs/api db:migrate",
    "db:status": "pnpm --filter @qs/api db:status",
    "dev:services": "bash scripts/dev-services.sh start"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
